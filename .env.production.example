# Verified existing server: MariaDB 10.4.30, database mkm_ssmdb, account it.
# Never copy local .env credentials or run local reset scripts on production.
APP_ENV=production
INTEGRATION_STORAGE=legacy_app
DB_CONNECTION=mysql
# Verified local server connection, 27 October 2026.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mkm_ssmdb
DB_USERNAME=it
DB_PASSWORD=
LEGACY_SCHEMA=public
APP_KEY=
DB_READER_USERNAME=
DB_READER_PASSWORD=
DB_SETTINGS_USERNAME=
DB_SETTINGS_PASSWORD=
DB_RECEIVER_USERNAME=
DB_RECEIVER_PASSWORD=
DB_WORKER_USERNAME=
DB_WORKER_PASSWORD=
ATTENDANCE_TIMEZONE=Asia/Jakarta
MEKARI_BASE_URL=https://api.mekari.com
MEKARI_CLIENT_ID=
MEKARI_CLIENT_SECRET=
MEKARI_IMPORT_TOKEN=
MEKARI_COMPANY_ID=11423
MEKARI_CA_BUNDLE=
ATTENDANCE_TEST_NIK=2120
TALENTA_USER_ID=2371526
TALENTA_CSV_PROFILE_CONFIRMED=true
TALENTA_LEGACY_RAW_CONFIRMED=true
DRY_RUN=true
ALLOW_PRODUCTION_WRITE=false
TALENTA_SCHEDULER_ENABLED=false
MACHINE_RECEIVER_ENABLED=false
# Prefer explicit terminal addresses. Use * only behind a reviewed internal
# firewall/Apache boundary; the physical-receiver confirmation gate still applies.
MACHINE_ALLOWED_IPS=127.0.0.1,::1
MACHINE_ALLOW_SIMULATOR=false
MACHINE_SIMULATOR_PATH=API/index.php
LEGACY_LOCAL_WRITE=false
# Allows only the localhost card-2120 simulator to insert FlFlag=0 into
# mkm_ssmdb. It does not enable the physical receiver or Talenta submission.
LEGACY_PRODUCTION_RECEIVER_WRITE_CONFIRMED=false
LEGACY_PRODUCTION_PHYSICAL_RECEIVER_CONFIRMED=false
LEGACY_DIRECTION_MAP={}

# HRMS is independent of Talenta. Keep disabled until legacy writer cutover.
HRMS_EXPORT_ENABLED=false
HRMS_EXPORT_ON_RECEIVE=false
HRMS_SDF_PATH=C:\ABSENSI_MKM\ABSENSI.SDF
HRMS_EXPORT_FROM=
# Captured 28 October payloads with protocol code 10 later appeared as FcDirection=1.
# Reconfirm this relationship with the operator before enabling physical writes.
HRMS_DIRECTION_CONFIRMED=false
